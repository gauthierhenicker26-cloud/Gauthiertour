{
  "name": "gauthiertours",
  "version": "1.0.1",
  "description": "GAUTHIERTOURS - Jeu de plateau",
  "main": "main.js",
  "author": "GAUTHIERTOURS",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.gauthiertours.app",
    "productName": "GAUTHIERTOURS",
    "files": [
      "index.html",
      "main.js",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "gauthierhenicker26-cloud",
      "repo": "Gauthiertour",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
